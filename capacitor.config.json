{
  "appId": "mx.com.chamba",
  "appName": "Chamba",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "url": "https://chamba-delta.vercel.app",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.mercadopago.com",
      "*.mercadopago.com.mx",
      "*.mercadolibre.com",
      "sdk.mercadopago.com",
      "api.mercadopago.com",
      "auth.mercadopago.com",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}